# Acquit.ai Unified Environment Configuration

# ------------------------------------------------------------------------------
# SUPABASE / DATABASE (Local & Remote)
# ------------------------------------------------------------------------------
# The full connection string to your PostgreSQL / Supabase database.
# For local dev: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# MODEL GATEWAY / AI PROVIDERS
# ------------------------------------------------------------------------------
# Google Gemini API key (Required for primary AI functions)
GEMINI_API_KEY=

# (Optional) Other providers if implemented in the Model Gateway
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# GOOGLE WORKSPACE OAUTH
# ------------------------------------------------------------------------------
# No secrets needed here if using Firebase Auth client-side popups for Google Auth.
# However, if server-side validation or webhook ingestion is added, configure:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# REDIS / RATE LIMITING
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# SECURITY & SECRETS
# ------------------------------------------------------------------------------
# Used for session cookies, JWT signing, etc.
SESSION_SECRET=

# ------------------------------------------------------------------------------
# COURT CONNECTORS (e.g., CourtListener)
# ------------------------------------------------------------------------------
COURTLISTENER_API_TOKEN=
