{
  "name": "acquit-ai-api-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  }
}
