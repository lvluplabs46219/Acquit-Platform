# Acquit API — local / production env template
# Copy to .env.local and fill values. Never commit secrets.

PORT=3001
NODE_ENV=development

# ---- Default LLM: local Ollama (no Gemini required) ----
ACQUIT_DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Pull a model first: ollama pull llama3.2

# Optional cloud fallbacks (disabled when provider=ollama)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
